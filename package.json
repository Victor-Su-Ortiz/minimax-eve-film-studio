{
  "name": "minimax-directors-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:agent": "eve build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "setup:video-import": "python3 -m venv .tools/social-video && .tools/social-video/bin/pip install 'yt-dlp[default]==2026.8.19'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "ai": "7.0.143",
    "eve": "0.80.1",
    "just-bash": "^3.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
