# Bring your own MiniMax credentials. No author-owned keys are included.
# Copy to .env.local for local use, or set these on your own deployment.
# Keep credentials server-side. Use Node.js 24+.
# These MiniMax endpoints are preconfigured; choose model IDs your keys can access.
MINIMAX_TEXT_API_KEY=
MINIMAX_TEXT_BASE_URL=https://api.minimax.io/anthropic/v1
MINIMAX_TEXT_MODEL=MiniMax-M3.1-Flash-Preview

# Choose an H3/V2-compatible video model; this key may differ from the text key.
MINIMAX_VIDEO_API_KEY=
MINIMAX_VIDEO_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3

# Public trend discovery via TwitterAPI.io. Server only.
TWITTERAPI_IO_API_KEY=
# TikTok video extraction: npm run setup:video-import
# YTDLP_PATH=/absolute/path/to/yt-dlp

# Local private studio. All media, manifests and exports stay in this folder.
# This must be the same absolute path in both Next.js and eve if overridden.
# STUDIO_DATA_DIR=/absolute/path/to/private-studio-data
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
