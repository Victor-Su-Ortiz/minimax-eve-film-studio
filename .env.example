# Bring your own MiniMax credentials. No author-owned keys are included.
# Copy to .env.local for local use, or set these on your own deployment.
# Keep credentials server-side. Use Node.js 24.
# These MiniMax endpoints are preconfigured; choose model IDs your keys can access.
MINIMAX_TEXT_API_KEY=
MINIMAX_TEXT_BASE_URL=https://api.minimax.io/anthropic/v1
MINIMAX_TEXT_MODEL=MiniMax-M3.1-Flash-Preview

# Choose an H3/V2-compatible video model; this key may differ from the text key.
MINIMAX_VIDEO_API_KEY=
MINIMAX_VIDEO_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3

# Storyboards use MiniMax Image-01. Defaults to the video key above.
# Set a separate image key only if your image entitlement uses another account.
MINIMAX_IMAGE_API_KEY=
MINIMAX_IMAGE_MODEL=image-01

# All search providers are optional; upload reference clips without any search keys.
# auto prefers official X when its token exists, otherwise TwitterAPI.io.
# Choose official, twitterapi-io or none to pin/disable X lookup and discovery.
X_SEARCH_PROVIDER=auto
# Official X API v2 (optional). Recent search covers the last 7 days.
# Your developer account needs access/quota for search and post/media lookup.
X_API_BEARER_TOKEN=
# Alternative optional X provider. Server only.
TWITTERAPI_IO_API_KEY=

# Optional broader public-web discovery (indexed social pages and campaign sites).
# Search leads still need separate video and view-count verification.
EXA_API_KEY=
# TikTok video extraction: npm run setup:video-import
# YTDLP_PATH=/absolute/path/to/yt-dlp

# Local private studio. All media, manifests and exports stay in this folder.
# This must be the same absolute path in both Next.js and eve if overridden.
# STUDIO_DATA_DIR=/absolute/path/to/private-studio-data
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Optional hosted instance (see docs/hosted-starter.md).
# Each deployer configures their own Neon database and private Blob store.
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://...
# BLOB_READ_WRITE_TOKEN=
# STUDIO_STORAGE=cloud
# Set this only after enabling Vercel Authentication for ALL deployments.
# STUDIO_DEPLOYMENT_PROTECTED=true
# STUDIO_HOST=your-studio.vercel.app
